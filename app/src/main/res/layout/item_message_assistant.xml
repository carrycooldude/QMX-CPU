<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tvAssistantMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_message_assistant"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="#F1F5F9"
        android:textSize="14sp" />

    <!-- Dual Voice Actions: Android System TTS & Qwen3-TTS Neural Stream -->
    <LinearLayout
        android:id="@+id/layoutVoiceActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Android Native TTS Button (0s Instant) -->
        <TextView
            android:id="@+id/btnSpeakAndroid"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_chip_suggestion"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="🔊 System Voice (0s)"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Qwen3-TTS Neural Stream Button -->
        <TextView
            android:id="@+id/btnSpeakQwen"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_suggestion"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="🧠 Qwen3-TTS (Neural)"
            android:textColor="#A855F7"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
